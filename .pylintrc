# Pylint configuration used by Codacy (and available for local runs with
# ``pylint --rcfile .pylintrc``). Formatting is enforced by black/isort/flake8
# (see pyproject.toml), so this file only tunes the code-quality checks.

[MAIN]
py-version = 3.9
jobs = 0

[MESSAGES CONTROL]
disable =
    # the pydocstyle codes below are unknown to plain pylint.
    unknown-option-value,
    # docstrings are not mandatory; their style is Google style (``Args:`` /
    # ``Returns:`` sections) with a lower-cased summary ending with e.g.
    # "(Internal method)", which conflicts with the numpy-style docstring rules
    # D213, D406, D407, D413 and with D403 / D415.
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    D100, D101, D102, D103, D104, D105, D106, D107,
    D213,
    D403,
    D406,
    D407,
    D413,
    D415,
    # runners and tests call internal (underscored) methods of simulators,
    # markets, and agents by design.
    protected-access,
    # TODO comments are tracked in the code base.
    fixme,
    # abstract methods and dummy classes consist of a docstring and ``pass``.
    unnecessary-pass,
    # design-size checks are not meaningful for simulation agents/markets/tests.
    too-many-arguments,
    too-many-positional-arguments,
    too-many-instance-attributes,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-return-statements,
    too-many-public-methods,
    too-few-public-methods,
    too-many-lines,
    duplicate-code,

[FORMAT]
# black wraps code at 88 characters but leaves long docstrings and strings.
max-line-length = 120

[BASIC]
# test constants such as ``WAIT_TIME`` and short loop variables are fine.
good-names = i, j, k, n, t, x, y, fp, id, _
