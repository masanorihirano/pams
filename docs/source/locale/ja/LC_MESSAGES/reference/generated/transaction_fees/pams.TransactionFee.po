msgid "Parameters"
msgstr "パラメータ"

#: of pams.transaction_fees.TransactionFee.compute_fees:7
msgid "executed price."
msgstr "約定価格。"

#: of pams.transaction_fees.TransactionFee.compute_fees:10
msgid "executed volume."
msgstr "約定数量。"

#: of pams.transaction_fees.TransactionFee.compute_fees:13
msgid "buy order. Its volume still includes the executed volume."
msgstr "買い注文。その数量にはまだ約定数量が含まれています。"

#: of pams.transaction_fees.TransactionFee.compute_fees:16
msgid "sell order. Its volume still includes the executed volume."
msgstr "売り注文。その数量にはまだ約定数量が含まれています。"

#: ../../source/reference/generated/transaction_fees/pams.TransactionFee.rst
msgid "Returns"
msgstr "戻り値"

#: of pams.transaction_fees.TransactionFee.compute_fees:19
msgid ""
"transaction fees of the buyer and of the seller, which must be finite "
"numbers. Negative fees are rebates, which are added to the cash."
msgstr "買い手と売り手の取引手数料。いずれも有限の数値でなければなりません。負の手数料はリベートであり、現金に加算されます。"

